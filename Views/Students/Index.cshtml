@model List<Student>
<h1>Студенты</h1>
<p><a asp-action="Create">Добавить студента</a></p>
<table>
    <tr><th>Имя</th><th>Количество курсов</th><th>Действия</th></tr>
    @foreach (Student item in Model)
    {
        <tr>
            <td>@item.Name</td><td>@item.Courses.Count</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.StudentId">Просмотр</a>
                <a asp-action="Edit" asp-route-id="@item.StudentId">Редактировать</a>
                <a asp-action="Delete" asp-route-id="@item.StudentId">Удалить</a>
            </td>
        </tr>
    }
</table>
