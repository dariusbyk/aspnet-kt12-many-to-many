@model TeacherForm
<h1>Добавление преподавателя</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="error"></div>
    <p><label asp-for="Name">Имя</label><input asp-for="Name" /></p>
    <button type="submit">Сохранить</button>
    <a asp-action="Index">Отмена</a>
</form>
