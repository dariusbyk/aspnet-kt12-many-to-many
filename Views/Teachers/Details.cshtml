@model Teacher
<h1>@Model.Name</h1>
<p>ID преподавателя: @Model.TeacherId</p>
<h2>Курсы преподавателя</h2>
<ul>
@foreach (Course course in Model.Courses)
{
    <li><a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId">@course.Title</a></li>
}
</ul>
<a asp-action="Edit" asp-route-id="@Model.TeacherId">Редактировать преподавателя</a>
